{
  "type": "object",
  "properties": {
    "name": { "type": "string" },
    "manufacturer": { "type": "string" },
    "maintainer": { "type": "string" },
    "usb": {
      "type": "object",
      "description": "USB configuration",
      "properties": {
        "vid": {
          "type": "string",
          "description": "USB Vendor ID",
          "pattern": "^0x[0-9A-Fa-f]{4}$"
        },
        "pid": {
          "type": "string",
          "description": "USB Product ID",
          "pattern": "^0x[0-9A-Fa-f]{4}$"
        },
        "port": {
          "enum": ["fs", "hs"],
          "description": "fs: Full Speed, hs: High Speed"
        }
      },
      "required": ["vid", "pid", "port"]
    },
    "features": {
      "type": "object",
      "description": "Feature flags for firmware and configurator",
      "properties": {
        "rgb": { "type": "boolean" },
        "joystick": { "type": "boolean" },
        "encoder": { "type": "boolean" },
        "slider": { "type": "boolean" },
        "trackball": { "type": "boolean" }
      }
    },
    "keyboard": {
      "type": "object",
      "description": "Keyboard configuration",
      "properties": {
        "num_profiles": {
          "type": "integer",
          "minimum": 1,
          "maximum": 8
        },
        "num_layers": {
          "type": "integer",
          "minimum": 1,
          "maximum": 8
        },
        "num_keys": {
          "type": "integer",
          "minimum": 1,
          "maximum": 256
        },
        "num_advanced_keys": {
          "type": "integer",
          "minimum": 1,
          "maximum": 64
        }
      },
      "required": [
        "num_profiles",
        "num_layers",
        "num_keys",
        "num_advanced_keys"
      ]
    },
    "hardware": {
      "type": "object",
      "description": "Hardware configuration",
      "properties": {
        "hse_value": {
          "type": "integer",
          "description": "High-speed external oscillator value in Hz"
        },
        "cpu_hz": {
          "type": "integer",
          "minimum": 1,
          "description": "Optional CPU/system clock frequency in Hz for the PlatformIO F_CPU definition"
        },
        "driver": {
          "type": "string",
          "description": "Keyboard driver name"
        },
        "timings": {
          "type": "object",
          "description": "Background task scheduler intervals and phases",
          "properties": {
            "usb": {
              "type": "object",
              "properties": {
                "interval": { "type": "integer", "minimum": 1 },
                "phase": { "type": "integer", "minimum": 0 }
              },
              "required": ["interval", "phase"]
            },
            "layout": {
              "type": "object",
              "properties": {
                "interval": { "type": "integer", "minimum": 1 },
                "phase": { "type": "integer", "minimum": 0 }
              },
              "required": ["interval", "phase"]
            },
            "xinput": {
              "type": "object",
              "properties": {
                "interval": { "type": "integer", "minimum": 1 },
                "phase": { "type": "integer", "minimum": 0 }
              },
              "required": ["interval", "phase"]
            },
            "command": {
              "type": "object",
              "properties": {
                "interval": { "type": "integer", "minimum": 1 },
                "phase": { "type": "integer", "minimum": 0 }
              },
              "required": ["interval", "phase"]
            },
            "trackball": {
              "type": "object",
              "properties": {
                "interval": { "type": "integer", "minimum": 1 },
                "phase": { "type": "integer", "minimum": 0 }
              },
              "required": ["interval", "phase"]
            },
            "joystick": {
              "type": "object",
              "properties": {
                "interval": { "type": "integer", "minimum": 1 },
                "phase": { "type": "integer", "minimum": 0 }
              },
              "required": ["interval", "phase"]
            },
            "encoder": {
              "type": "object",
              "properties": {
                "interval": { "type": "integer", "minimum": 1 },
                "phase": { "type": "integer", "minimum": 0 }
              },
              "required": ["interval", "phase"]
            },
            "slider": {
              "type": "object",
              "properties": {
                "interval": { "type": "integer", "minimum": 1 },
                "phase": { "type": "integer", "minimum": 0 }
              },
              "required": ["interval", "phase"]
            },
            "rgb": {
              "type": "object",
              "properties": {
                "interval": { "type": "integer", "minimum": 1 },
                "phase": { "type": "integer", "minimum": 0 }
              },
              "required": ["interval", "phase"]
            }
          }
        },
        "spi": {
          "type": "object",
          "description": "General SPI bus configuration for peripherals such as trackball sensors",
          "properties": {
            "buses": {
              "type": "array",
              "description": "Array of SPI bus definitions",
              "items": {
                "type": "object",
                "properties": {
                  "instance": {
                    "type": "string",
                    "description": "SPI peripheral instance, e.g. SPI1, SPI2, SPI3"
                  },
                  "clock_hz": {
                    "type": "integer",
                    "minimum": 1,
                    "description": "Input clock frequency for the SPI peripheral in Hz"
                  },
                  "sck_pin": {
                    "type": "string",
                    "description": "GPIO pin name for SCK (e.g. \"C10\")"
                  },
                  "miso_pin": {
                    "type": "string",
                    "description": "GPIO pin name for MISO (e.g. \"C11\")"
                  },
                  "mosi_pin": {
                    "type": "string",
                    "description": "GPIO pin name for MOSI (e.g. \"C12\")"
                  },
                  "pin_mux": {
                    "type": "string",
                    "description": "GPIO mux value for AT32 (e.g. GPIO_MUX_6)"
                  },
                  "pin_af": {
                    "type": "string",
                    "description": "GPIO alternate function for STM32"
                  }
                },
                "required": ["instance", "clock_hz", "sck_pin"]
              }
            }
          },
          "required": ["buses"]
        },
        "clock": {
          "type": "object",
          "description": "Optional board-specific clock/PLL overrides",
          "properties": {
            "pll_ns": { "type": "integer", "minimum": 1 },
            "pll_ms": { "type": "integer", "minimum": 1 },
            "pll_fp": { "type": "string" },
            "pll_fu": { "type": "string" },
            "apb2_div": { "type": "string" },
            "apb1_div": { "type": "string" }
          }
        }
      },
      "required": ["hse_value", "driver"]
    },
    "analog": {
      "type": "object",
      "description": "Analog configuration",
      "properties": {
        "backend": {
          "enum": ["mcu_adc", "spi_adc"],
          "default": "mcu_adc",
          "description": "Analog sampling backend. `mcu_adc` uses the MCU's built-in ADC. `spi_adc` uses an external SPI ADC backend."
        },
        "adc_resolution": {
          "type": "integer",
          "description": "ADC resolution for this keyboard. A higher value means higher accuracy but slower matrix scans. Default to the maximum resolution supported by the MCU if not provided."
        },
        "invert_adc": {
          "type": "boolean",
          "description": "Set to true if the ADC value is inversely proportional to the travel distance of the keys"
        },
        "delay": {
          "type": "integer",
          "description": "Delay in microseconds between ADC scans",
          "minimum": 0
        },
        "raw": {
          "type": "object",
          "description": "Raw ADC input configuration",
          "properties": {
            "input": {
              "type": "array",
              "description": "Array of raw ADC input channels. If a string is provided, it is used as the GPIO pin name",
              "items": { "type": ["integer", "string"], "minimum": 0 }
            },
            "vector": {
              "type": "array",
              "description": "Array of key index mappings for the raw ADC inputs",
              "items": { "type": "integer", "minimum": 0 }
            }
          },
          "required": ["input", "vector"]
        },
        "mux": {
          "type": "object",
          "description": "Analog multiplexer ADC input configuration",
          "properties": {
            "select": {
              "type": "array",
              "description": "Array of GPIO pin names for the multiplexer select lines",
              "items": { "type": "string" }
            },
            "input": {
              "type": "array",
              "description": "Array of ADC input channels for the multiplexers. If a string is provided, it is used as the GPIO pin name",
              "items": { "type": ["integer", "string"], "minimum": 0 }
            },
            "matrix": {
              "type": "array",
              "description": "Mapping from multiplexers to ADC input channels",
              "items": {
                "type": "array",
                "items": { "type": "integer", "minimum": 0 }
              }
            }
          },
          "required": ["select", "input", "matrix"]
        },
        "spi": {
          "type": "object",
          "description": "External SPI ADC configuration. Currently supports ADS7953 on up to 2 SPI buses with up to 2 devices per bus.",
          "properties": {
            "driver": {
              "enum": ["ads7953"],
              "description": "External SPI ADC driver"
            },
            "frequency_hz": {
              "type": "integer",
              "description": "SPI clock frequency in Hz. Defaults to 20 MHz when omitted.",
              "minimum": 1
            },
            "range": {
              "enum": ["vref", "2xvref"],
              "description": "ADS7953 input range selection. `vref` uses 0-Vref, `2xvref` uses 0-2xVref."
            },
            "buses": {
              "type": "array",
              "minItems": 1,
              "maxItems": 2,
              "items": {
                "type": "object",
                "properties": {
                  "bus": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 3,
                    "description": "SPI bus index defined by board_def.h"
                  },
                  "gpio": {
                    "type": "object",
                    "description": "GPIO pins used for this SPI ADC bus when they differ from the general SPI bus definition",
                    "properties": {
                      "sck_pin": { "type": "string" },
                      "miso_pin": { "type": "string" },
                      "mosi_pin": { "type": "string" }
                    },
                    "required": ["sck_pin", "miso_pin", "mosi_pin"]
                  },
                  "devices": {
                    "type": "array",
                    "minItems": 1,
                    "maxItems": 2,
                    "items": {
                      "type": "object",
                      "properties": {
                        "cs": {
                          "type": "string",
                          "description": "GPIO pin name used as chip select"
                        },
                        "map": {
                          "type": "array",
                          "description": "16-entry physical key mapping for ADS7953 channels. Uses the same 1-based key numbering convention as analog.raw.vector, and 0 means unused.",
                          "minItems": 16,
                          "maxItems": 16,
                          "items": {
                            "type": "integer",
                            "minimum": 0
                          }
                        }
                      },
                      "required": ["cs", "map"]
                    }
                  }
                },
                "required": ["bus", "devices"]
              }
            }
          },
          "required": ["driver", "buses"]
        }
      }
    },
    "matrix": {
      "type": "object",
      "description": "Matrix scanning and scheduler configuration",
      "properties": {
        "processing_divider": {
          "type": "integer",
          "minimum": 1,
          "maximum": 8,
          "description": "Matrix processing divider. Lower values yield higher scan rates."
        },
        "scheduler_max_catchup_scans": {
          "type": "integer",
          "minimum": 0,
          "description": "Maximum number of catch-up scans the scheduler may perform in one iteration."
        },
        "scheduler_budget_us": {
          "type": "integer",
          "minimum": 0,
          "description": "Soft diagnostic budget for one matrix processing interval in microseconds."
        },
        "adc_sample_delay_default": {
          "type": "integer",
          "minimum": 0,
          "description": "Default multiplexer settle delay in microseconds."
        },
        "analog_scan_key_version_delta": {
          "type": "integer",
          "minimum": 0,
          "description": "Key version delta threshold for analog scan."
        },
        "detailed_scan_diagnostics": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1,
          "description": "Enable detailed per-key scan diagnostics."
        },
        "idle_raw_fast_path_margin": {
          "type": "integer",
          "minimum": 0,
          "description": "ADC margin used for the idle-key fast path."
        },
        "live_scan_timing_diagnostics": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1,
          "description": "Enable live scan timing diagnostics."
        }
      }
    },
    "digital": {
      "type": "object",
      "description": "Direct GPIO digital input configuration",
      "properties": {
        "input": {
          "type": "array",
          "description": "Array of GPIO pin names for digital inputs",
          "items": { "type": "string" }
        },
        "vector": {
          "type": "array",
          "description": "Array of physical key number mappings for each digital input",
          "items": { "type": "integer", "minimum": 0 }
        },
        "pull": {
          "enum": ["none", "up", "down"],
          "description": "Internal pull resistor configuration. Defaults to pull-up."
        },
        "active_low": {
          "type": "boolean",
          "description": "Set to false when a high logic level means the switch is pressed"
        }
      },
      "required": ["input", "vector"]
    },
    "encoder": {
      "type": "object",
      "description": "Rotary encoder key index mapping for configurator integration",
      "properties": {
        "map": {
          "type": "array",
          "description": "Array of rotary encoder direction mappings",
          "items": {
            "type": "object",
            "properties": {
              "label": {
                "type": "string",
                "description": "Display label for this encoder in the configurator"
              },
              "cw": {
                "type": "integer",
                "minimum": 0,
                "description": "0-based key index triggered by clockwise rotation"
              },
              "ccw": {
                "type": "integer",
                "minimum": 0,
                "description": "0-based key index triggered by counterclockwise rotation"
              }
            },
            "required": ["cw", "ccw"]
          }
        },
        "hardware": {
          "type": "object",
          "description": "Rotary encoder GPIO and direction configuration",
          "properties": {
            "a_pins": {
              "type": "array",
              "description": "GPIO pin names for the encoder A signals",
              "items": { "type": "string" }
            },
            "b_pins": {
              "type": "array",
              "description": "GPIO pin names for the encoder B signals",
              "items": { "type": "string" }
            },
            "invert_directions": {
              "type": "array",
              "description": "Per-encoder direction inversion flags (0 or 1)",
              "items": { "type": "integer", "minimum": 0, "maximum": 1 }
            },
            "pullup": {
              "type": "boolean",
              "description": "Enable internal pull-up on encoder GPIO inputs"
            }
          },
          "required": ["a_pins", "b_pins"]
        }
      },
      "required": ["map"]
    },
    "joystick": {
      "type": "object",
      "description": "Joystick hardware configuration",
      "properties": {
        "enabled": {
          "type": "boolean",
          "description": "Enable joystick input"
        },
        "sw_pin": {
          "type": "string",
          "description": "GPIO pin name for the joystick switch (e.g. \"A9\")"
        },
        "x_adc_index": {
          "type": "integer",
          "minimum": 0,
          "description": "ADC input index for the X axis"
        },
        "y_adc_index": {
          "type": "integer",
          "minimum": 0,
          "description": "ADC input index for the Y axis"
        },
        "sw_key_index": {
          "type": "integer",
          "minimum": 0,
          "description": "Key index mapped to the joystick switch"
        }
      },
      "required": ["enabled", "sw_pin", "x_adc_index", "y_adc_index", "sw_key_index"]
    },
    "trackball": {
      "type": "object",
      "description": "Trackball sensor hardware configuration",
      "properties": {
        "enabled": {
          "type": "boolean",
          "description": "Enable trackball input"
        },
        "sensor": {
          "type": "string",
          "description": "Sensor driver name, e.g. PAW3395"
        },
        "spi_bus": {
          "type": "integer",
          "minimum": 0,
          "description": "Index into hardware.spi.buses used for the sensor"
        },
        "cs_pin": {
          "type": "string",
          "description": "GPIO pin name used as chip select"
        },
        "motion_pin": {
          "type": "string",
          "description": "GPIO pin name connected to the sensor motion interrupt"
        },
        "spi_frequency_hz": {
          "type": "integer",
          "minimum": 1,
          "description": "SPI clock frequency used for the sensor"
        },
        "cpi_default": {
          "type": "integer",
          "minimum": 1,
          "description": "Default CPI setting"
        },
        "spi_hold_time_us": {
          "type": "integer",
          "minimum": 0,
          "description": "Minimum CS high time between SPI transactions in microseconds"
        }
      },
      "required": ["enabled", "sensor", "spi_bus", "cs_pin", "motion_pin"]
    },
    "calibration": {
      "type": "object",
      "description": "Calibration configuration",
      "properties": {
        "initial_rest_value": {
          "type": "integer",
          "description": "See `eeconfig.h`",
          "minimum": 0
        },
        "initial_bottom_out_threshold": {
          "type": "integer",
          "description": "See `eeconfig.h`",
          "minimum": 0
        }
      },
      "required": ["initial_rest_value", "initial_bottom_out_threshold"]
    },
    "wear_leveling": {
      "type": "object",
      "description": "Wear leveling configuration",
      "properties": {
        "virtual_size": {
          "type": "integer",
          "description": "Size of the virtual persistent storage in bytes. There must be enough RAM of this size to hold the entire virtual storage.",
          "minimum": 1,
          "default": 8192
        },
        "write_log_size": {
          "type": "integer",
          "description": "Size of the write log in bytes",
          "minimum": 1,
          "default": 65536
        }
      }
    },
    "memory_budget": {
      "type": "object",
      "description": "Firmware memory budget thresholds used by CI checks",
      "properties": {
        "min_flash_headroom": {
          "type": "integer",
          "description": "Minimum flash headroom in bytes after subtracting the wear-leveling reservation",
          "minimum": 0
        },
        "min_ram_headroom": {
          "type": "integer",
          "description": "Minimum RAM headroom in bytes after subtracting the heap/stack reservation",
          "minimum": 0
        },
        "max_stack_frame": {
          "type": "integer",
          "description": "Optional per-function stack usage limit in bytes for GCC .su reports",
          "minimum": 0
        }
      }
    },
    "layout": {
      "type": "object",
      "properties": {
        "labels": {
          "type": "array",
          "description": "Labels for each layout option. Use a string for a toggle option, or an array for a select option",
          "items": { "type": ["string", "array"] }
        },
        "keymap": {
          "type": "array",
          "description": "Metadata for how the keyboard should be rendered in the web configurator",
          "items": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "key": { "type": "integer", "minimum": 0 },
                "w": { "type": "number", "minimum": 1 },
                "h": { "type": "number", "minimum": 1 },
                "x": { "type": "number" },
                "y": { "type": "number" },
                "label": { "type": "string" },
                "r": { "type": "number", "description": "Rotation angle in degrees" },
                "option": {
                  "type": "array",
                  "description": "Option key and value pairs for the corresponding labels",
                  "items": { "type": "number" }
                }
              }
            }
          }
        }
      },
      "required": ["keymap"]
    },
    "keymap": {
      "type": "array",
      "description": "Default keymap",
      "items": {
        "type": "array",
        "items": { "type": "string" }
      }
    },
    "keymaps": {
      "type": "array",
      "description": "Default keymaps for each profile. If not specified, the default keymap will be used for all profiles.",
      "items": {
        "type": "array",
        "items": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "actuation": {
      "type": "object",
      "description": "Actuation configuration",
      "properties": {
        "actuation_point": {
          "type": "integer",
          "description": "Default actuation point",
          "minimum": 0,
          "maximum": 255
        }
      }
    },
    "kalman": {
      "type": "object",
      "description": "Kalman filter configuration. When omitted, compile-time defaults from matrix.h are used.",
      "properties": {
        "position_gain": {
          "type": "number",
          "description": "Position gain (alpha). Controls how quickly the estimated position follows the raw ADC value.",
          "minimum": 0.0,
          "maximum": 1.0
        },
        "velocity_gain": {
          "type": "number",
          "description": "Velocity gain (beta). Controls how quickly the estimated velocity follows observed changes.",
          "minimum": 0.0,
          "maximum": 1.0
        },
        "velocity_damping": {
          "type": "number",
          "description": "Velocity damping multiplier applied while the key is resting or holding a bottom-out event. Values in [0.0, 1.0] reduce velocity-estimate drift.",
          "minimum": 0.0,
          "maximum": 1.0
        },
        "rt_down_min_velocity": {
          "type": "number",
          "description": "Minimum downward velocity (distance units per scan) required to arm a Rapid Trigger press or re-press.",
          "minimum": 0.0,
          "maximum": 10.0
        },
        "rt_up_min_velocity": {
          "type": "number",
          "description": "Minimum upward velocity (distance units per scan) required to arm a Rapid Trigger release.",
          "minimum": 0.0,
          "maximum": 10.0
        },
        "innovation_event_threshold": {
          "type": "number",
          "description": "Fixed innovation threshold (distance units) used to detect a bottom-out collision. The prediction overshoots when the key slams into the plate, producing a large negative innovation.",
          "minimum": 0.0,
          "maximum": 100.0
        },
        "bottom_out_hold_scans": {
          "type": "integer",
          "description": "Number of scans after a bottom-out event during which the release threshold is temporarily reduced and velocity is damped.",
          "minimum": 0,
          "maximum": 100
        },
        "bottom_out_rt_up": {
          "type": "integer",
          "description": "Reduced Rapid Trigger release distance used while a bottom-out hold is active.",
          "minimum": 0,
          "maximum": 255
        },
        "noise_deadzone": {
          "type": "integer",
          "description": "ADC units above the rest value that are treated as noise floor and clamped to zero distance.",
          "minimum": 0,
          "maximum": 20
        }
      }
    },
    "rgb": {
      "type": "object",
      "description": "RGB configuration",
      "properties": {
        "led_map": {
          "type": "array",
          "items": { "type": "integer", "minimum": 0 }
        },
        "mod_keys": {
          "type": "array",
          "description": "Key indices that should be treated as modifiers in ALPHAS_MODS.",
          "items": { "type": "integer", "minimum": 0 }
        },
        "hardware": {
          "type": "object",
          "description": "RGB hardware configuration. When omitted, RGB compile-time macros must be provided by a generated or manual board_def.h.",
          "properties": {
            "num_leds": {
              "type": "integer",
              "minimum": 1,
              "description": "Number of RGB LEDs"
            },
            "data_pin": {
              "type": "string",
              "description": "GPIO pin name for the RGB data line (e.g. \"A10\")"
            },
            "timer": {
              "type": "string",
              "description": "Hardware timer used for RGB PWM/DMA (e.g. \"TMR1\")"
            },
            "timer_channel": {
              "type": "string",
              "description": "Timer channel used for RGB (e.g. \"TMR_SELECT_CHANNEL_3\")"
            },
            "dma_channel": {
              "type": "string",
              "description": "DMA channel used for RGB (e.g. \"DMA1_CHANNEL2\")"
            },
            "dma_mux_channel": {
              "type": "string",
              "description": "DMAMUX channel used for RGB (driver-specific)"
            },
            "dma_transfer_flag": {
              "type": "string",
              "description": "DMA transfer complete flag (driver-specific)"
            },
            "dma_clear_flag": {
              "type": "string",
              "description": "DMA global clear flag (driver-specific)"
            },
            "reset_time_ns": {
              "type": "integer",
              "minimum": 0,
              "description": "RGB reset time in nanoseconds"
            },
            "dma_frame_repeats": {
              "type": "integer",
              "minimum": 1,
              "description": "Number of times each RGB DMA frame is repeated"
            },
